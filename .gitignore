# Miscellaneous
*.log
*.lock
# ...but pubspec.lock MUST be versioned for an application. It pins resolved
# package versions (e.g. flutter_map 8.3.2), so a fresh clone builds the same
# way this machine does. Flutter's guidance is to commit it for apps.
!pubspec.lock
*.pid
*.pid.lock
*.sqlite
*.db
*.db-journal
*.tmp
*.temp
*.swp

# Signing keystores ARE the app's identity - never version them.
*.jks
*.keystore

# Unrelated project trees sitting next to the app, plus their artefacts:
# pickled models, Python caches, vector stores and logs.
/main/
/sage/
__pycache__/
*.pyc
*.pkl
chroma_db/

# Captured `flutter run` session output (created on demand, never versioned)
/run_log.txt

# OS generated
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
